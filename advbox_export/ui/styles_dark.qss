/*
 * Paleta sage green warm (dark mode) — espelha o monorepo direito-do-campo.
 *
 *   Fundo da janela      #0f1411  (verde-preto)
 *   Fundo de card        #18211b
 *   Texto principal      #f3ede5  (creme)
 *   Texto secundário     #97a59e
 *   Borda                #2d3d33
 *   Primária             #5ba367  (sage claro)
 *   Primária hover       #4d8a58
 *   Primária texto       #0f1411
 *   Sucesso              #3d9d4d
 *   Erro                 #e85555
 *   Aviso                #fbbf24
 *   Muted (disabled)     #2d3d33
 *   Hover bg             #223028
 *   Alert bg             #3a2e1a
 */

* {
    font-family: "Geist", "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 14px;
    color: #f3ede5;
}

QMainWindow,
QWidget#centralWidget,
QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: #0f1411;
}

QMenuBar {
    background-color: #0f1411;
    border-bottom: 1px solid #2d3d33;
    padding: 4px 8px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #223028;
}
QMenu {
    background-color: #18211b;
    border: 1px solid #2d3d33;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 16px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #223028;
}
QMenu::separator {
    height: 1px;
    background: #2d3d33;
    margin: 4px 6px;
}

QStatusBar {
    background-color: #0f1411;
    border-top: 1px solid #2d3d33;
    color: #97a59e;
    font-size: 12px;
}

/* ---------- Cards ---------- */
QFrame#card {
    background-color: #18211b;
    border: 1px solid #2d3d33;
    border-radius: 10px;
}

QLabel#cardTitle {
    font-size: 16px;
    font-weight: 600;
    color: #f3ede5;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 0 4px 0;
}

QLabel#sectionLabel {
    font-size: 11px;
    font-weight: 500;
    color: #97a59e;
    background: transparent;
    border: none;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QLabel#mutedLabel {
    color: #97a59e;
    font-size: 13px;
    background: transparent;
}

/* ---------- Botões ---------- */
QPushButton {
    background-color: #5ba367;
    color: #0f1411;
    border: 1px solid #5ba367;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #6cb478;
    border-color: #6cb478;
}
QPushButton:pressed {
    background-color: #4d8a58;
}
QPushButton:disabled {
    background-color: #2d3d33;
    color: #6a7972;
    border-color: #2d3d33;
}

QPushButton[variant="outline"] {
    background-color: transparent;
    color: #f3ede5;
    border: 1px solid #2d3d33;
}
QPushButton[variant="outline"]:hover {
    background-color: #223028;
    border-color: #3d524a;
}
QPushButton[variant="outline"]:disabled {
    background-color: #18211b;
    color: #6a7972;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    color: #5ba367;
    border: 1px solid transparent;
    padding: 6px 12px;
    font-weight: 500;
}
QPushButton[variant="ghost"]:hover {
    background-color: #223028;
}

QPushButton[variant="danger"] {
    background-color: #18211b;
    color: #e85555;
    border: 1px solid #3a2020;
}
QPushButton[variant="danger"]:hover {
    background-color: #2a1a1a;
    border-color: #553030;
}

QPushButton[variant="chip"] {
    background-color: transparent;
    color: #f3ede5;
    border: 1px solid #2d3d33;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    min-height: 20px;
}
QPushButton[variant="chip"]:hover {
    background-color: #223028;
    border-color: #3d524a;
}
QPushButton[variant="chip"]:checked {
    background-color: #5ba367;
    color: #0f1411;
    border-color: #5ba367;
}
QPushButton[variant="chip"]:checked:hover {
    background-color: #6cb478;
    border-color: #6cb478;
}

/* Outline pequeno — usado nos botões inline da tabela de histórico */
QPushButton[variant="outline-sm"] {
    background-color: transparent;
    color: #f3ede5;
    border: 1px solid #3d524a;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    min-height: 14px;
    max-height: 26px;
    min-width: 48px;
    max-width: 64px;
}
QPushButton[variant="outline-sm"]:hover {
    background-color: #223028;
    border-color: #5ba367;
    color: #5ba367;
}
QPushButton[variant="outline-sm"]:disabled {
    background-color: transparent;
    color: #4a564f;
    border-color: #1f2c25;
}

QPushButton[variant="outline-sm-danger"] {
    background-color: transparent;
    color: #e85555;
    border: 1px solid #553030;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton[variant="outline-sm-danger"]:hover {
    background-color: #2a1a1a;
    border-color: #e85555;
}

/* Botão lixeira: só ícone */
QPushButton[variant="trash"] {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    qproperty-iconSize: 16px 16px;
}
QPushButton[variant="trash"]:hover {
    background-color: #2a1a1a;
    border-color: #553030;
}

/* ---------- Inputs ---------- */
QLineEdit,
QDateEdit,
QSpinBox,
QComboBox {
    background-color: #18211b;
    border: 1px solid #2d3d33;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #f3ede5;
    selection-background-color: #5ba367;
    selection-color: #0f1411;
}
QLineEdit:focus,
QDateEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid #5ba367;
}
QLineEdit:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    background-color: #1a2420;
    color: #6a7972;
}

QDateEdit::drop-down,
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border-left: 1px solid #2d3d33;
}
QDateEdit::down-arrow,
QComboBox::down-arrow {
    image: url({{CHEVRON_DOWN}});
    width: 12px;
    height: 12px;
}

/* ---------- QCalendarWidget (popup do DateEdit) ---------- */
QCalendarWidget {
    background-color: #18211b;
    border: 1px solid #2d3d33;
    border-radius: 10px;
}
QCalendarWidget QWidget {
    background-color: #18211b;
    color: #f3ede5;
    font-size: 13px;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #1a2420;
    border-bottom: 1px solid #2d3d33;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    min-height: 40px;
}
QCalendarWidget QToolButton {
    color: #f3ede5;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    margin: 4px 2px;
    font-size: 13px;
    font-weight: 500;
}
QCalendarWidget QToolButton:hover {
    background-color: #223028;
    border-color: #2d3d33;
}
QCalendarWidget QToolButton::menu-indicator {
    image: none;
}
QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url({{CHEVRON_LEFT}});
    qproperty-iconSize: 14px 14px;
}
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url({{CHEVRON_RIGHT}});
    qproperty-iconSize: 14px 14px;
}
QCalendarWidget QSpinBox {
    background-color: #18211b;
    border: 1px solid #2d3d33;
    border-radius: 6px;
    padding: 4px 6px;
    min-width: 60px;
    color: #f3ede5;
}
QCalendarWidget QMenu {
    background-color: #18211b;
    border: 1px solid #2d3d33;
    border-radius: 8px;
    padding: 4px;
}
QCalendarWidget QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
    color: #f3ede5;
}
QCalendarWidget QMenu::item:selected {
    background-color: #223028;
}
QCalendarWidget QAbstractItemView {
    background-color: #18211b;
    selection-background-color: #5ba367;
    selection-color: #0f1411;
    color: #f3ede5;
    outline: none;
    gridline-color: transparent;
    font-size: 13px;
}
QCalendarWidget QAbstractItemView:disabled {
    color: #4a564f;
}

QCheckBox {
    spacing: 8px;
    color: #f3ede5;
    background: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2d3d33;
    border-radius: 4px;
    background: #18211b;
}
QCheckBox::indicator:checked {
    background-color: #5ba367;
    border-color: #5ba367;
}

/* ---------- Log view ---------- */
QPlainTextEdit {
    background-color: #14191a;
    border: 1px solid #2d3d33;
    border-radius: 8px;
    padding: 10px;
    font-family: "Geist Mono", "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
    color: #d4d8d4;
    selection-background-color: #5ba367;
    selection-color: #0f1411;
}

/* ---------- Progress bar ---------- */
QProgressBar {
    background-color: #223028;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #5ba367;
    border-radius: 4px;
}

/* ---------- Tabela ---------- */
QHeaderView {
    background-color: #1a2420;
    border: none;
}
QHeaderView::section {
    background-color: #1a2420;
    color: #97a59e;
    border: none;
    border-bottom: 1px solid #2d3d33;
    border-right: 1px solid #223028;
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 500;
}
QHeaderView::section:last {
    border-right: none;
}

QTableWidget,
QTableView {
    background-color: #18211b;
    alternate-background-color: #1a2420;
    border: 1px solid #2d3d33;
    border-radius: 8px;
    gridline-color: #223028;
    selection-background-color: #223028;
    selection-color: #f3ede5;
    color: #f3ede5;
}
QTableWidget::item,
QTableView::item {
    padding: 8px 6px;
    border: none;
}
QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #1f2c25;
}
QTableCornerButton::section {
    background-color: #1a2420;
    border: none;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2d3d33;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #3d524a;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #2d3d33;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #3d524a;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Dialog ---------- */
QDialog {
    background-color: #0f1411;
}

QDialogButtonBox QPushButton {
    min-width: 88px;
}

QMessageBox {
    background-color: #18211b;
}
QMessageBox QLabel {
    color: #f3ede5;
    background: transparent;
}

/* ---------- Banner alerta ---------- */
QFrame#alertCard {
    background-color: #3a2e1a;
    border: 1px solid #f59e0b;
    border-radius: 10px;
}
QFrame#alertCard QLabel {
    background: transparent;
    color: #fde68a;
}
QLabel#alertTitle {
    font-size: 14px;
    font-weight: 600;
    color: #fde68a;
    background: transparent;
}
QLabel#alertBody {
    font-size: 13px;
    color: #fcd34d;
    background: transparent;
}
QFrame#alertCard QPushButton {
    background-color: #f59e0b;
    color: #0f1411;
    border: 1px solid #f59e0b;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
}
QFrame#alertCard QPushButton:hover {
    background-color: #fbbf24;
    border-color: #fbbf24;
}

/* ---------- Tabs (Export / Grupos) ---------- */
QTabWidget::pane {
    border: 1px solid #2d3d33;
    border-radius: 12px;
    background-color: #18211b;
    top: -1px;
    padding: 4px;
}
QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background-color: transparent;
    color: #97a59e;
    padding: 9px 22px;
    margin-right: 6px;
    margin-bottom: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-weight: 500;
    min-width: 80px;
}
QTabBar::tab:hover:!selected {
    background-color: #223028;
    color: #f3ede5;
}
QTabBar::tab:selected {
    background-color: #5ba367;
    color: #0f1411;
    font-weight: 600;
}

/* ---------- Cards de grupo (aba Grupos) ---------- */
QFrame#grupoCard {
    background-color: #18211b;
    border: 1px solid #2d3d33;
    border-radius: 10px;
}
QFrame#grupoCard:hover {
    border-color: #3d524a;
}
QLabel#grupoNome {
    color: #f3ede5;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
}
QLabel#grupoSubtitulo {
    color: #97a59e;
    font-size: 12px;
    background: transparent;
}
QToolButton#grupoMenu {
    background-color: transparent;
    color: #97a59e;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 18px;
    font-weight: 700;
}
QToolButton#grupoMenu:hover {
    background-color: #223028;
    color: #f3ede5;
}
QToolButton#grupoMenu::menu-indicator {
    image: none;
    width: 0;
}
