/*
 * Paleta sage green warm (light mode) — espelha o monorepo direito-do-campo.
 * Cores em hex (aproximação dos oklch() do Tailwind config).
 *
 *   Fundo da janela      #fefdf8  (creme muito claro)
 *   Fundo de card        #ffffff
 *   Texto principal      #1a2420
 *   Texto secundário     #677872
 *   Borda                #d4e1d9
 *   Primária (botão)     #3a5a45  (sage green)
 *   Primária hover       #324d3b
 *   Primária texto       #fefdf8
 *   Sucesso              #2d7a3e
 *   Erro                 #d93a3a
 *   Aviso                #f59e0b
 *   Muted (disabled)     #f3ede5
 *   Sidebar/Section bg   #eef2ee
 */

* {
    font-family: "Geist", "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 14px;
    color: #1a2420;
}

QMainWindow,
QWidget#centralWidget,
QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: #fefdf8;
}

QMenuBar {
    background-color: #fefdf8;
    border-bottom: 1px solid #d4e1d9;
    padding: 4px 8px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #eef2ee;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #d4e1d9;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 16px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #eef2ee;
}
QMenu::separator {
    height: 1px;
    background: #d4e1d9;
    margin: 4px 6px;
}

QStatusBar {
    background-color: #fefdf8;
    border-top: 1px solid #d4e1d9;
    color: #677872;
    font-size: 12px;
}

/* ---------- Cards ---------- */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #d4e1d9;
    border-radius: 10px;
}

QLabel#cardTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1a2420;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 0 4px 0;
}

QLabel#sectionLabel {
    font-size: 11px;
    font-weight: 500;
    color: #677872;
    background: transparent;
    border: none;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QLabel#mutedLabel {
    color: #677872;
    font-size: 13px;
    background: transparent;
}

/* ---------- Botões ---------- */
QPushButton {
    background-color: #3a5a45;
    color: #fefdf8;
    border: 1px solid #3a5a45;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #324d3b;
    border-color: #324d3b;
}
QPushButton:pressed {
    background-color: #28402f;
}
QPushButton:disabled {
    background-color: #d4e1d9;
    color: #97a59e;
    border-color: #d4e1d9;
}

QPushButton[variant="outline"] {
    background-color: #ffffff;
    color: #1a2420;
    border: 1px solid #d4e1d9;
}
QPushButton[variant="outline"]:hover {
    background-color: #eef2ee;
    border-color: #b9ccc1;
}
QPushButton[variant="outline"]:disabled {
    background-color: #f3ede5;
    color: #97a59e;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    color: #3a5a45;
    border: 1px solid transparent;
    padding: 6px 12px;
    font-weight: 500;
}
QPushButton[variant="ghost"]:hover {
    background-color: #eef2ee;
}

QPushButton[variant="danger"] {
    background-color: #ffffff;
    color: #d93a3a;
    border: 1px solid #f3ede5;
}
QPushButton[variant="danger"]:hover {
    background-color: #fdecec;
    border-color: #f5b8b8;
}

/* Chip toggle: outline transparente, vira preenchido quando "checked" */
QPushButton[variant="chip"] {
    background-color: transparent;
    color: #1a2420;
    border: 1px solid #d4e1d9;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    min-height: 20px;
}
QPushButton[variant="chip"]:hover {
    background-color: #f5f8f5;
    border-color: #b9ccc1;
}
QPushButton[variant="chip"]:checked {
    background-color: #3a5a45;
    color: #fefdf8;
    border-color: #3a5a45;
}
QPushButton[variant="chip"]:checked:hover {
    background-color: #324d3b;
    border-color: #324d3b;
}

/* Outline pequeno — usado nos botões inline da tabela de histórico */
QPushButton[variant="outline-sm"] {
    background-color: #ffffff;
    color: #1a2420;
    border: 1px solid #b9ccc1;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 14px;
}
QPushButton[variant="outline-sm"]:hover {
    background-color: #eef2ee;
    border-color: #3a5a45;
    color: #3a5a45;
}
QPushButton[variant="outline-sm"]:disabled {
    background-color: #fafbf9;
    color: #b9ccc1;
    border-color: #eef2ee;
}

QPushButton[variant="outline-sm-danger"] {
    background-color: #ffffff;
    color: #d93a3a;
    border: 1px solid #f5b8b8;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton[variant="outline-sm-danger"]:hover {
    background-color: #fdecec;
    border-color: #d93a3a;
}

/* Botão lixeira: só ícone, fundo transparente */
QPushButton[variant="trash"] {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    qproperty-iconSize: 16px 16px;
}
QPushButton[variant="trash"]:hover {
    background-color: #fdecec;
    border-color: #f5b8b8;
}

/* Banner de alerta (token ausente, avisos importantes) */
QFrame#alertCard {
    background-color: #fff8eb;
    border: 1px solid #f59e0b;
    border-radius: 10px;
}
QFrame#alertCard QLabel {
    background: transparent;
    color: #78350f;
}
QLabel#alertTitle {
    font-size: 14px;
    font-weight: 600;
    color: #78350f;
    background: transparent;
}
QLabel#alertBody {
    font-size: 13px;
    color: #92400e;
    background: transparent;
}
QFrame#alertCard QPushButton {
    background-color: #f59e0b;
    color: #ffffff;
    border: 1px solid #f59e0b;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 500;
}
QFrame#alertCard QPushButton:hover {
    background-color: #d97706;
    border-color: #d97706;
}

/* ---------- Inputs ---------- */
QLineEdit,
QDateEdit,
QSpinBox,
QComboBox {
    background-color: #ffffff;
    border: 1px solid #d4e1d9;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #1a2420;
    selection-background-color: #3a5a45;
    selection-color: #fefdf8;
}
QLineEdit:focus,
QDateEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid #3a5a45;
}
QLineEdit:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    background-color: #f3ede5;
    color: #97a59e;
}

QDateEdit::drop-down,
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border-left: 1px solid #d4e1d9;
}
QDateEdit::down-arrow,
QComboBox::down-arrow {
    image: url({{CHEVRON_DOWN}});
    width: 12px;
    height: 12px;
}

/* ---------- QCalendarWidget (popup do DateEdit) ---------- */
QCalendarWidget {
    background-color: #ffffff;
    border: 1px solid #d4e1d9;
    border-radius: 10px;
}
QCalendarWidget QWidget {
    background-color: #ffffff;
    color: #1a2420;
    font-size: 13px;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #f5f8f5;
    border-bottom: 1px solid #d4e1d9;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    min-height: 40px;
}
QCalendarWidget QToolButton {
    color: #1a2420;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    margin: 4px 2px;
    font-size: 13px;
    font-weight: 500;
}
QCalendarWidget QToolButton:hover {
    background-color: #eef2ee;
    border-color: #d4e1d9;
}
QCalendarWidget QToolButton::menu-indicator {
    image: none;
}
QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url({{CHEVRON_LEFT}});
    qproperty-iconSize: 14px 14px;
}
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url({{CHEVRON_RIGHT}});
    qproperty-iconSize: 14px 14px;
}
QCalendarWidget QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d4e1d9;
    border-radius: 6px;
    padding: 4px 6px;
    min-width: 60px;
}
QCalendarWidget QMenu {
    background-color: #ffffff;
    border: 1px solid #d4e1d9;
    border-radius: 8px;
    padding: 4px;
}
QCalendarWidget QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
}
QCalendarWidget QMenu::item:selected {
    background-color: #eef2ee;
}
QCalendarWidget QAbstractItemView {
    background-color: #ffffff;
    selection-background-color: #3a5a45;
    selection-color: #fefdf8;
    color: #1a2420;
    outline: none;
    gridline-color: transparent;
    font-size: 13px;
}
QCalendarWidget QAbstractItemView:disabled {
    color: #b9ccc1;
}

QCheckBox {
    spacing: 10px;
    color: #1a2420;
    background: transparent;
    padding: 4px 2px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #b9ccc1;
    border-radius: 4px;
    background: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #3a5a45;
    background: #f5f8f5;
}
QCheckBox::indicator:checked {
    background-color: #3a5a45;
    border-color: #3a5a45;
    image: url({{CHECK}});
}
QCheckBox::indicator:checked:hover {
    background-color: #324d3b;
    border-color: #324d3b;
}
QCheckBox::indicator:disabled {
    background: #f3ede5;
    border-color: #d4e1d9;
}

/* ---------- Log view (mono) ---------- */
QPlainTextEdit {
    background-color: #fafbf9;
    border: 1px solid #d4e1d9;
    border-radius: 8px;
    padding: 10px;
    font-family: "Geist Mono", "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
    color: #1a2420;
    selection-background-color: #3a5a45;
    selection-color: #fefdf8;
}

/* ---------- Progress bar ---------- */
QProgressBar {
    background-color: #eef2ee;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #3a5a45;
    border-radius: 4px;
}

/* ---------- Tabela ---------- */
QHeaderView {
    background-color: #f5f8f5;
    border: none;
}
QHeaderView::section {
    background-color: #f5f8f5;
    color: #677872;
    border: none;
    border-bottom: 1px solid #d4e1d9;
    border-right: 1px solid #eef2ee;
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 500;
}
QHeaderView::section:last {
    border-right: none;
}

QTableWidget,
QTableView {
    background-color: #ffffff;
    alternate-background-color: #fafbf9;
    border: 1px solid #d4e1d9;
    border-radius: 8px;
    gridline-color: #eef2ee;
    selection-background-color: #eef2ee;
    selection-color: #1a2420;
}
QTableWidget::item,
QTableView::item {
    padding: 8px 6px;
    border: none;
}
QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #f5f8f5;
}
QTableCornerButton::section {
    background-color: #f5f8f5;
    border: none;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #d4e1d9;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #b9ccc1;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #d4e1d9;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #b9ccc1;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Dialog ---------- */
QDialog {
    background-color: #fefdf8;
}

QDialogButtonBox QPushButton {
    min-width: 88px;
}

QMessageBox {
    background-color: #ffffff;
}
QMessageBox QLabel {
    color: #1a2420;
    background: transparent;
}

/* ---------- Tabs (Export / Grupos) ---------- */
QTabWidget::pane {
    border: 1px solid #d4e1d9;
    border-radius: 12px;
    background-color: #ffffff;
    top: -1px;
    padding: 4px;
}
QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background-color: transparent;
    color: #677872;
    padding: 9px 22px;
    margin-right: 6px;
    margin-bottom: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-weight: 500;
    min-width: 80px;
}
QTabBar::tab:hover:!selected {
    background-color: #eef2ee;
    color: #1a2420;
}
QTabBar::tab:selected {
    background-color: #3a5a45;
    color: #fefdf8;
    font-weight: 600;
}

/* ---------- Cards de grupo (aba Grupos) ---------- */
QFrame#grupoCard {
    background-color: #ffffff;
    border: 1px solid #d4e1d9;
    border-radius: 10px;
}
QFrame#grupoCard:hover {
    border-color: #b9ccc1;
}
QLabel#grupoNome {
    color: #1a2420;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
}
QLabel#grupoSubtitulo {
    color: #677872;
    font-size: 12px;
    background: transparent;
}
QToolButton#grupoMenu {
    background-color: transparent;
    color: #677872;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 18px;
    font-weight: 700;
}
QToolButton#grupoMenu:hover {
    background-color: #eef2ee;
    color: #1a2420;
}
QToolButton#grupoMenu::menu-indicator {
    image: none;
    width: 0;
}
